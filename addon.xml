<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<addon
    id="plugin.video.wsplay"
    name="WSPlay"
    version="1.0.0"
    provider-name="Wesley">

    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>

    <extension
        point="xbmc.python.pluginsource"
        library="addon.py">
        <provides>video</provides>
    </extension>

    <extension point="xbmc.addon.metadata">
        <summary>WSPlay</summary>
        <description>Addon de vídeo para Kodi.</description>
        <platform>all</platform>
        <license>MIT</license>
    </extension>

</addon>
